ThetaData/lib/
ThetaData/config.toml

# ── Deploy runtime artifacts ──────────────────────────────────────────
Deploy/logs/
Deploy/*.pid

# ── Reference / scratch (not part of the app) ──────────────────────────
Temp/

# ── C# / .NET ──────────────────────────────────────────────────────────
**/bin/
**/obj/
*.user
*.suo
*.userprefs
Logs/
*.log

# ── Node / Next.js ─────────────────────────────────────────────────────
node_modules/
.next/
out/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

